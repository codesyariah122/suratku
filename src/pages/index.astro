---
import Layout from '../layouts/Layout.astro'
---

<Layout title="SuratKu - Generator Surat Digital">
  <main class="landing-page">
    <nav class="landing-nav">
      <div class="landing-brand">
        SuratKu
      </div>

      <div class="landing-nav-actions">
        <a href="/login" class="btn-login">
          Login
        </a>

        <a href="/register" class="btn-register">
          Buat Akun
        </a>
      </div>
    </nav>

    <section class="hero-section">
      <div class="hero-content">
        <span class="hero-badge">
          Generator Surat Digital
        </span>

        <h1>
          Buat Surat Resmi
          <span>Lebih Cepat & Mudah</span>
        </h1>

        <p>
          SuratKu membantu kamu membuat berbagai jenis surat
          secara cepat, rapi, dan profesional.
        </p>

        <div class="hero-actions">
          <a href="/register" class="hero-primary">
            Mulai Sekarang
          </a>

          <a href="/login" class="hero-secondary">
            Sudah punya akun?
          </a>
        </div>
      </div>

      <div class="hero-card">
        <div class="document-preview">
          <div class="document-header">
            <div class="document-logo">
              SK
            </div>

            <div>
              <strong>SURATKU</strong>
              <small>Generator Surat Digital</small>
            </div>
          </div>

          <div class="document-line large"></div>
          <div class="document-line"></div>
          <div class="document-line"></div>
          <div class="document-line short"></div>

          <div class="document-content">
            <div class="document-line"></div>
            <div class="document-line"></div>
            <div class="document-line short"></div>
          </div>

          <div class="document-signature">
            <div class="document-line short"></div>
            <strong>Penandatangan</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="features-section">
      <div class="section-heading">
        <span>KENAPA SURATKU?</span>

        <h2>
          Semua kebutuhan surat dalam satu tempat
        </h2>

        <p>
          Buat surat dengan proses yang sederhana tanpa perlu
          membuat format dari awal.
        </p>
      </div>

      <div class="features-grid">
        <article class="feature-card">
          <div class="feature-icon">01</div>

          <h3>Mudah Digunakan</h3>

          <p>
            Pilih template, isi data, dan surat siap digunakan.
          </p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">02</div>

          <h3>Template Profesional</h3>

          <p>
            Gunakan template surat yang rapi dan siap pakai.
          </p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">03</div>

          <h3>Kelola Surat</h3>

          <p>
            Simpan dan kelola surat yang sudah kamu buat.
          </p>
        </article>
      </div>
    </section>

    <section class="cta-section">
      <h2>
        Siap membuat surat?
      </h2>

      <p>
        Buat akun gratis dan mulai gunakan SuratKu.
      </p>

      <a href="/register" class="hero-primary">
        Buat Akun Sekarang
      </a>
    </section>

    <footer class="landing-footer">
      <strong>SuratKu</strong>

      <span>
        © 2026 SuratKu. Semua hak dilindungi.
      </span>
    </footer>
  </main>
</Layout>

<style>
  .landing-page {
    min-height: 100vh;
    background: #f8fafc;
    color: #111827;
  }

  .landing-nav {
    width: min(1120px, calc(100% - 48px));
    margin: 0 auto;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .landing-brand {
    font-size: 22px;
    font-weight: 800;
    color: #111827;
  }

  .landing-nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .landing-nav a {
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .btn-login {
    color: #374151;
    padding: 10px 16px;
  }

  .btn-register {
    padding: 10px 18px;
    color: white;
    background: #2563eb;
    border-radius: 8px;
  }

  .hero-section {
    width: min(1120px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 620px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 80px;
  }

  .hero-badge {
    display: inline-block;
    margin-bottom: 18px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-size: 13px;
    font-weight: 700;
  }

  .hero-content h1 {
    margin: 0;
    max-width: 650px;
    font-size: clamp(42px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -2px;
  }

  .hero-content h1 span {
    display: block;
    color: #2563eb;
  }

  .hero-content > p {
    max-width: 560px;
    margin: 24px 0 32px;
    color: #6b7280;
    font-size: 17px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hero-primary,
  .hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 20px;
    border-radius: 9px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .hero-primary {
    background: #2563eb;
    color: white;
  }

  .hero-secondary {
    color: #374151;
    background: white;
    border: 1px solid #e5e7eb;
  }

  .hero-card {
    display: flex;
    justify-content: center;
  }

  .document-preview {
    width: min(100%, 420px);
    min-height: 500px;
    padding: 36px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    box-shadow:
      0 30px 60px rgba(15, 23, 42, 0.1),
      0 8px 20px rgba(15, 23, 42, 0.05);
    transform: rotate(2deg);
  }

  .document-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 24px;
    border-bottom: 2px solid #e5e7eb;
  }

  .document-logo {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    font-size: 14px;
    font-weight: 800;
  }

  .document-header strong {
    display: block;
    font-size: 14px;
  }

  .document-header small {
    display: block;
    margin-top: 3px;
    color: #9ca3af;
    font-size: 10px;
  }

  .document-line {
    width: 100%;
    height: 8px;
    margin-top: 14px;
    border-radius: 4px;
    background: #e5e7eb;
  }

  .document-line.large {
    width: 75%;
    height: 14px;
    margin-top: 32px;
  }

  .document-line.short {
    width: 55%;
  }

  .document-content {
    margin-top: 42px;
  }

  .document-signature {
    width: 45%;
    margin-top: 70px;
    margin-left: auto;
  }

  .document-signature strong {
    display: block;
    margin-top: 10px;
    font-size: 10px;
    color: #6b7280;
    text-align: center;
  }

  .features-section {
    width: min(1120px, calc(100% - 48px));
    margin: 80px auto;
  }

  .section-heading {
    max-width: 650px;
    margin-bottom: 40px;
  }

  .section-heading > span {
    color: #2563eb;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .section-heading h2 {
    margin: 10px 0;
    font-size: 34px;
    line-height: 1.2;
  }

  .section-heading p {
    color: #6b7280;
    line-height: 1.7;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .feature-card {
    padding: 28px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
  }

  .feature-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border-radius: 8px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 12px;
    font-weight: 800;
  }

  .feature-card h3 {
    margin: 0 0 8px;
    font-size: 18px;
  }

  .feature-card p {
    margin: 0;
    color: #6b7280;
    font-size: 14px;
    line-height: 1.7;
  }

  .cta-section {
    width: min(900px, calc(100% - 48px));
    margin: 120px auto 80px;
    padding: 70px 30px;
    text-align: center;
    background: #eff6ff;
    border: 1px solid #dbeafe;
    border-radius: 20px;
  }

  .cta-section h2 {
    margin: 0;
    font-size: 36px;
  }

  .cta-section p {
    margin: 12px 0 28px;
    color: #6b7280;
  }

  .landing-footer {
    width: min(1120px, calc(100% - 48px));
    margin: 0 auto;
    padding: 30px 0;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #e5e7eb;
    color: #6b7280;
    font-size: 13px;
  }

  @media (max-width: 800px) {
    .hero-section {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 60px 0;
    }

    .hero-content h1 {
      font-size: 44px;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .hero-card {
      display: none;
    }

    .landing-footer {
      flex-direction: column;
      gap: 8px;
    }
  }

  @media (max-width: 480px) {
    .landing-nav {
      width: calc(100% - 32px);
    }

    .btn-login {
      display: none;
    }

    .hero-section,
    .features-section,
    .cta-section {
      width: calc(100% - 32px);
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>