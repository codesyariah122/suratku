---
import Layout from '../layouts/Layout.astro'
import AuthShowcase from '../components/auth/AuthShowcase.astro'
import Brand from '../components/Brand.astro'
---

<Layout title="Register">
  <main class="auth-page">
    <Brand class="auth-home" decorative />

    <section class="auth-shell">
      <AuthShowcase variant="register" />

      <div class="auth-card auth-card-register">
        <span class="auth-kicker">BUAT RUANG KERJA ANDA</span>
        <h1>Mulai dengan SuratKu</h1>
        <p class="auth-description">Gratis untuk memulai. Siapkan akun Anda dalam satu menit.</p>

        <form id="register-form">
          <div class="form-group">
            <label for="full_name">Nama Lengkap</label>
            <div class="input-wrap">
              <span class="input-icon">Aa</span><input
                type="text"
                id="full_name"
                name="full_name"
                placeholder="Nama lengkap Anda"
                autocomplete="name"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <div class="input-wrap">
              <span class="input-icon">@</span><input
                type="email"
                id="email"
                name="email"
                placeholder="nama@perusahaan.com"
                autocomplete="email"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-wrap">
              <span class="input-icon">●</span><input
                type="password"
                id="password"
                name="password"
                placeholder="Minimal 6 karakter"
                autocomplete="new-password"
                minlength="6"
                required
              /><button
                class="password-toggle"
                type="button"
                aria-label="Tampilkan password"
                data-password-toggle="password">Lihat</button
              >
            </div>
          </div>

          <div class="form-group">
            <label for="password_confirmation">Konfirmasi Password</label>
            <div class="input-wrap">
              <span class="input-icon">✓</span><input
                type="password"
                id="password_confirmation"
                name="password_confirmation"
                placeholder="Ulangi password"
                autocomplete="new-password"
                minlength="6"
                required
              /><button
                class="password-toggle"
                type="button"
                aria-label="Tampilkan konfirmasi password"
                data-password-toggle="password_confirmation">Lihat</button
              >
            </div>
          </div>

          <button type="submit" id="register-button">Buat akun gratis <span>→</span></button>

          <p id="register-message" class="message"></p>
        </form>

        <p class="auth-footer">Sudah punya akun? <a href="/login">Masuk di sini</a></p>
        <p class="auth-assurance">Dengan mendaftar, Anda menyetujui penggunaan layanan SuratKu.</p>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase'
  import { initializePasswordToggles } from '../lib/client/authUi'

  const form = document.querySelector('#register-form') as HTMLFormElement
  const button = document.querySelector('#register-button') as HTMLButtonElement
  const message = document.querySelector('#register-message') as HTMLParagraphElement

  initializePasswordToggles()

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()

    const fullName = (document.querySelector('#full_name') as HTMLInputElement).value.trim()

    const email = (document.querySelector('#email') as HTMLInputElement).value.trim()

    const password = (document.querySelector('#password') as HTMLInputElement).value

    const passwordConfirmation = (
      document.querySelector('#password_confirmation') as HTMLInputElement
    ).value

    message.textContent = ''
    message.className = 'message'

    if (password !== passwordConfirmation) {
      message.textContent = 'Konfirmasi password tidak cocok.'
      message.classList.add('error')
      return
    }

    button.disabled = true
    button.textContent = 'Mendaftarkan...'

    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: {
        data: {
          full_name: fullName,
        },
      },
    })

    if (error) {
      message.textContent = error.message
      message.classList.add('error')

      button.disabled = false
      button.innerHTML = 'Buat akun gratis <span>→</span>'

      return
    }

    /*
     * Trigger PostgreSQL kita akan membuat public.profiles
     * otomatis ketika auth.users dibuat.
     */

    if (data.session) {
      // User langsung mendapatkan session.
      window.location.href = '/dashboard'
      return
    }

    // Jika email confirmation aktif.
    message.textContent = 'Registrasi berhasil. Silakan cek email untuk konfirmasi akun.'
    message.classList.add('success')

    form.reset()

    button.disabled = false
    button.innerHTML = 'Buat akun gratis <span>→</span>'
  })
</script>
