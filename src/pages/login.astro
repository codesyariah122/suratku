---
import Layout from '../layouts/Layout.astro'
import AuthShowcase from '../components/auth/AuthShowcase.astro'
import Brand from '../components/Brand.astro'
---

<Layout title="Login">
  <main class="auth-page">
    <Brand class="auth-home" decorative />

    <section class="auth-shell">
      <AuthShowcase variant="login" />

      <div class="auth-card">
        <span class="auth-kicker">SELAMAT DATANG KEMBALI</span>
        <h1>Masuk ke SuratKu</h1>
        <p class="auth-description">Lanjutkan pekerjaan dan kelola seluruh surat Anda.</p>

        <form id="login-form">
          <div class="form-group">
            <label for="email">Email</label>
            <div class="input-wrap">
              <span class="input-icon">@</span>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="nama@perusahaan.com"
                autocomplete="email"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-wrap">
              <span class="input-icon">●</span>
              <input
                type="password"
                id="password"
                name="password"
                placeholder="Masukkan password"
                autocomplete="current-password"
                required
              />
              <button
                class="password-toggle"
                type="button"
                aria-label="Tampilkan password"
                data-password-toggle="password">Lihat</button
              >
            </div>
          </div>

          <button type="submit" id="login-button">Masuk ke dashboard <span>→</span></button>

          <p id="login-message" class="message"></p>
        </form>

        <p class="auth-footer">Belum punya akun? <a href="/register">Buat akun gratis</a></p>
        <p class="auth-assurance">Dengan masuk, dokumen Anda tetap tersimpan secara aman.</p>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase'
  import { initializePasswordToggles } from '../lib/client/authUi'

  const form = document.querySelector('#login-form') as HTMLFormElement
  const button = document.querySelector('#login-button') as HTMLButtonElement
  const message = document.querySelector('#login-message') as HTMLParagraphElement

  initializePasswordToggles()

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()

    const email = (document.querySelector('#email') as HTMLInputElement).value.trim()

    const password = (document.querySelector('#password') as HTMLInputElement).value

    message.textContent = ''
    message.className = 'message'

    button.disabled = true
    button.textContent = 'Memeriksa akun...'

    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
    })

    if (error) {
      message.textContent = error.message
      message.classList.add('error')

      button.disabled = false
      button.innerHTML = 'Masuk ke dashboard <span>→</span>'

      return
    }

    if (data.user) {
      window.location.href = '/dashboard'
    }
  })
</script>
