      message.textContent = 'Isi utama surat wajib diisi.'
      message.className = 'message error'
      return
    }
    if (statusValue === 'final' && !form.reportValidity()) return
    const {
      data: { user },
    } = await supabase.auth.getUser()
    if (!user) return
    const fd = new FormData(form)
    const payload = {
      user_id: user.id,
      type: 'resmi',
      letter_number: fd.get('letter_number') || null,
      letter_date: fd.get('letter_date'),
      attachment: fd.get('attachment') || null,
      subject: fd.get('subject') || 'Tanpa perihal',
      recipient_name: fd.get('recipient_name') || 'Belum diisi',
      recipient_title: fd.get('recipient_title') || null,
      recipient_company: fd.get('recipient_company') || null,
      recipient_address: fd.get('recipient_address') || null,
      body: editorHtml(bodyEditor) || 'Belum diisi',
      closing: editorHtml(closingEditor) || null,
      sender_name: fd.get('sender_name') || 'Belum diisi',
      sender_title: fd.get('sender_title') || null,
      font_family: fontSelect.value,
      logo_url: logoUrl || null,
      status: statusValue,
      updated_at: new Date().toISOString(),
    }
    status.textContent = 'Menyimpan…'
    const query = editingId
      ? supabase.from('letters').update(payload).eq('id', editingId)
      : supabase.from('letters').insert(payload).select('id').single()
    const { data, error } = await query
    if (error) {
      status.textContent = 'Gagal disimpan'
      message.textContent = 'Jalankan migration document builder terbaru di Supabase.'
      message.className = 'message error'
      return
    }
    if (!editingId && data && 'id' in data) {
      editingId = data.id
      history.replaceState({}, '', `?id=${editingId}`)
    }
    status.textContent = statusValue === 'final' ? 'Tersimpan sebagai final' : 'Draf tersimpan'
    message.textContent = 'Surat berhasil disimpan ke riwayat.'
    message.className = 'message success'
