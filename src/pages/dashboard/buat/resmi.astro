      ? supabase.from('letters').update(payload).eq('id', editingId)
      : supabase.from('letters').insert(payload).select('id').single()
    const { data, error } = await query
    saving = false
    if (error) {
      status.textContent = 'Gagal disimpan'
      message.textContent = `Gagal menyimpan: ${error.message}`
      message.className = 'message error'
      return
    }
    if (!editingId && data && 'id' in data) {
