        ;(document.querySelector('#show_signature') as HTMLInputElement).checked =
          letter.show_signature !== false
        document.querySelector('.composer-header h1')!.textContent = 'Edit surat'
      }
    }
    const current = fonts.find(([name]) => name === fontSelect.value) || fonts[0]
    chooseFont(current[0], current[1])
    const logo = document.querySelector('#p-logo')!
    if (logoUrl) logo.innerHTML = `<img src="${logoUrl}" alt="Logo perusahaan" />`
    await loadTemplates()
    applyPaperSize()
    applyTypography()
    updatePreview()
    lastSavedSnapshot = currentSnapshot()
    initialized = true
    status.textContent = editingId ? 'Semua perubahan tersimpan' : 'Belum disimpan'
  }
  init()
</script>
