---
import DashboardLayout from '../../../layouts/DashboardLayout.astro'
---

<DashboardLayout title="Buat Surat Resmi - SuratKu">
  <section class="composer-shell">
    <header class="page-header composer-header">
      <div>
        <a class="text-link" href="/dashboard/buat">← Pilih template</a><h1>Buat surat resmi</h1><p>
          Isi data di kiri. Dokumen akan diperbarui secara langsung.
        </p>
      </div>
      <div class="header-actions">
        <span id="save-status" class="save-status">Belum disimpan</span><button
          id="print-button"
          class="secondary-button"
          type="button">Cetak / PDF</button
        >
      </div>
    </header>

    <form id="letter-form" class="composer-grid">
      <div class="composer-form">
        <section class="panel-card design-toolbar">
          <div class="template-picker-control">
            <label>Template saya</label><input id="template_select" type="hidden" value="" /><button
              id="template-picker-button"
              class="template-picker-button"
              type="button"
              aria-expanded="false"
            >
              <span class="template-picker-icon">◇</span><span class="template-picker-copy"
                ><strong id="selected-template-name">Surat kosong</strong><small
                  id="selected-template-meta">Mulai dari format surat resmi</small
                ></span
              ><span class="template-picker-chevron">⌄</span>
            </button><div id="template-picker-menu" class="template-picker-menu" hidden>
              <div class="template-picker-heading">
                <div>
                  <strong>Pilih template</strong><small>Gunakan format yang pernah disimpan</small>
                </div><span id="template-count" class="template-count">0</span>
              </div><label class="template-picker-search"
                ><span>⌕</span><input
                  id="template-picker-search"
                  type="search"
                  placeholder="Cari template…"
                /></label
              ><div id="composer-template-list" class="composer-template-list"></div>
            </div>
          </div><div class="font-control">
            <label>Font dokumen</label><select
              id="font_family"
              name="font_family"
              class="native-font-select"
              aria-hidden="true"><option value="Lora">Lora</option></select
            ><button
              id="font-picker-button"
              class="font-picker-button"
              type="button"
              aria-expanded="false"
              ><span id="selected-font">Lora</span><small>Serif</small><b>⌄</b></button
            ><div id="font-picker-menu" class="font-picker-menu" hidden>
              <div class="font-picker-search">
                <input id="font-search" type="search" placeholder="Cari font…" />
              </div><div id="font-options" class="font-options"></div>
            </div>
          </div><div class="composer-footer-position">
            <label>Posisi footer</label><div class="footer-alignment-control">
              <button type="button" data-composer-footer-align="left">Kiri</button><button
                type="button"
                data-composer-footer-align="right"
                class="active">Kanan</button
              >
            </div>
          </div><button id="save-template" class="secondary-button" type="button"
            >Simpan jadi template</button
          >
        </section>
        <section class="panel-card form-section">
          <div class="form-section-title">
            <span>01</span><div>
              <h2>Identitas surat</h2><p>Nomor, tanggal, dan pokok surat.</p>
            </div>
          </div><div class="form-grid">
            <div class="form-group">
              <label for="letter_number">Nomor surat</label><input
                id="letter_number"
                name="letter_number"
                placeholder="001/SK/IX/2026"
              />
            </div><div class="form-group">
              <label for="letter_date">Tanggal</label><input
                id="letter_date"
                name="letter_date"
                type="date"
                required
              />
            </div><div class="form-group">
              <label for="attachment">Lampiran</label><input
                id="attachment"
                name="attachment"
                placeholder="–"
              />
            </div><div class="form-group">
              <label for="subject">Perihal</label><input
                id="subject"
                name="subject"
                placeholder="Permohonan kerja sama"
                required
              />
            </div>
          </div>
        </section>
        <section class="panel-card form-section">
          <div class="form-section-title">
            <span>02</span><div><h2>Penerima</h2><p>Kepada siapa surat ini ditujukan.</p></div>
          </div><div class="form-grid">
            <div class="form-group">
              <label for="recipient_name">Nama penerima</label><input
                id="recipient_name"
                name="recipient_name"
                placeholder="Bapak/Ibu Nama Penerima"
                required
              />
            </div><div class="form-group">
              <label for="recipient_title">Jabatan</label><input
                id="recipient_title"
                name="recipient_title"
                placeholder="Direktur Utama"
              />
            </div><div class="form-group form-group-full">
              <label for="recipient_company">Instansi / perusahaan</label><input
                id="recipient_company"
                name="recipient_company"
                placeholder="PT Perusahaan Indonesia"
              />
            </div><div class="form-group form-group-full">
              <label for="recipient_address">Alamat</label><textarea
                id="recipient_address"
                name="recipient_address"
                rows="2"
                placeholder="Alamat lengkap penerima"></textarea>
            </div>
          </div>
        </section>
        <section class="panel-card form-section">
          <div class="form-section-title">
            <span>03</span><div>
              <h2>Isi surat</h2><p>Sampaikan maksud secara ringkas dan profesional.</p>
            </div>
          </div><div class="form-group">
            <label for="body-editor">Isi utama</label><textarea
              id="body"
              name="body"
              class="rich-editor-value"
              aria-hidden="true"></textarea>
            <div class="document-editor" data-editor-shell="body-editor">
              <div class="document-editor-toolbar" role="toolbar" aria-label="Format isi utama">
                <div class="editor-tool-group editor-history-tools">
                  <button type="button" data-editor-command="undo" title="Urungkan">↶</button>
                  <button type="button" data-editor-command="redo" title="Ulangi">↷</button>
                </div>
                <select
                  class="editor-style-select"
                  data-editor-value-command="formatBlock"
                  aria-label="Gaya paragraf"
                >
                  <option value="p">Paragraf</option><option value="h2">Judul</option><option
                    value="h3">Subjudul</option
                  ><option value="blockquote">Kutipan</option>
                </select>
                <div class="editor-tool-group">
                  <button type="button" data-editor-command="bold" title="Tebal"
                    ><strong>B</strong></button
                  >
                  <button type="button" data-editor-command="italic" title="Miring"
                    ><em>I</em></button
                  >
                  <button type="button" data-editor-command="underline" title="Garis bawah"
                    ><u>U</u></button
                  >
                  <button type="button" data-editor-command="strikeThrough" title="Coret"
                    ><s>S</s></button
                  >
                </div>
                <div class="editor-tool-group">
                  <button
                    type="button"
                    data-editor-command="insertUnorderedList"
                    title="Daftar poin">• Daftar</button
                  >
                  <button type="button" data-editor-command="insertOrderedList" title="Daftar nomor"
                    >1. Daftar</button
                  >
                </div>
                <div class="editor-tool-group editor-align-tools">
                  <button type="button" data-editor-command="justifyLeft" title="Rata kiri"
                    >≡</button
                  >
                  <button type="button" data-editor-command="justifyCenter" title="Rata tengah"
                    >≡</button
                  >
                  <button type="button" data-editor-command="justifyRight" title="Rata kanan"
                    >≡</button
                  >
                  <button type="button" data-editor-command="justifyFull" title="Rata kiri-kanan"
                    >☰</button
                  >
                </div>
                <div class="editor-tool-group editor-color-tools">
                  <label title="Warna teks"
                    >A<input
                      type="color"
                      value="#172033"
                      data-editor-color-command="foreColor"
                    /></label
                  >
                  <label class="editor-highlight" title="Warna sorotan"
                    >▰<input
                      type="color"
                      value="#fff2a8"
                      data-editor-color-command="hiliteColor"
                    /></label
                  >
                  <button type="button" data-editor-action="link" title="Tambahkan tautan">↗</button
                  >
                </div>
                <button type="button" class="editor-clear-format" data-editor-command="removeFormat"
                  >Hapus format</button
                >
              </div>
              <div
                id="body-editor"
                class="document-editor-canvas"
                contenteditable="true"
                role="textbox"
                aria-multiline="true"
                data-placeholder="Dengan hormat, tuliskan isi surat di sini..."
              >
              </div>
            </div>
          </div><div class="form-group">
            <label for="closing-editor">Kalimat penutup</label><textarea
              id="closing"
              name="closing"
              class="rich-editor-value"
              aria-hidden="true"></textarea>
            <div class="document-editor compact" data-editor-shell="closing-editor">
              <div
                class="document-editor-toolbar"
                role="toolbar"
                aria-label="Format kalimat penutup"
              >
                <div class="editor-tool-group editor-history-tools">
                  <button type="button" data-editor-command="undo" title="Urungkan">↶</button>
                  <button type="button" data-editor-command="redo" title="Ulangi">↷</button>
                </div>
                <select
                  class="editor-style-select"
                  data-editor-value-command="formatBlock"
                  aria-label="Gaya paragraf"
                >
                  <option value="p">Paragraf</option><option value="blockquote">Kutipan</option>
                </select>
                <div class="editor-tool-group">
                  <button type="button" data-editor-command="bold"><strong>B</strong></button>
                  <button type="button" data-editor-command="italic"><em>I</em></button>
                  <button type="button" data-editor-command="underline"><u>U</u></button>
                  <button type="button" data-editor-command="strikeThrough" title="Coret"
                    ><s>S</s></button
                  >
                </div>
                <div class="editor-tool-group editor-align-tools">
                  <button type="button" data-editor-command="justifyLeft" title="Rata kiri"
                    >≡</button
                  >
                  <button type="button" data-editor-command="justifyCenter" title="Rata tengah"
                    >≡</button
                  >
                  <button type="button" data-editor-command="justifyRight" title="Rata kanan"
                    >≡</button
                  >
                  <button type="button" data-editor-command="justifyFull" title="Rata kiri-kanan"
                    >☰</button
                  >
                </div>
                <div class="editor-tool-group editor-color-tools">
                  <label title="Warna teks"
                    >A<input
                      type="color"
                      value="#172033"
                      data-editor-color-command="foreColor"
                    /></label
                  >
                  <label class="editor-highlight" title="Warna sorotan"
                    >▰<input
                      type="color"
                      value="#fff2a8"
                      data-editor-color-command="hiliteColor"
                    /></label
                  >
                  <button type="button" data-editor-action="link" title="Tambahkan tautan">↗</button
                  >
                </div>
                <button type="button" class="editor-clear-format" data-editor-command="removeFormat"
                  >Hapus format</button
                >
              </div>
              <div
                id="closing-editor"
                class="document-editor-canvas"
                contenteditable="true"
                role="textbox"
                aria-multiline="true"
                data-placeholder="Tambahkan kalimat penutup surat..."
              >
              </div>
            </div>
          </div>
        </section>
        <section class="panel-card form-section">
          <div class="form-section-title">
            <span>04</span><div>
              <h2>Penandatangan</h2><p>Identitas pihak yang bertanggung jawab.</p>
            </div>
          </div><div class="form-grid">
            <div class="form-group">
              <label for="sender_name">Nama lengkap</label><input
                id="sender_name"
                name="sender_name"
                required
              />
            </div><div class="form-group">
              <label for="sender_title">Jabatan</label><input
                id="sender_title"
                name="sender_title"
                placeholder="Direktur"
              />
            </div>
          </div>
        </section>
        <div class="composer-actions">
          <button id="draft-button" class="secondary-button" type="button">Simpan draf</button
          ><button id="final-button" class="primary-button" type="submit"
            >Simpan sebagai final</button
          >
        </div><p id="form-message" class="message"></p>
      </div>

      <aside class="preview-pane">
        <div class="preview-label">
          <div>
            <span class="preview-live-dot"></span><span>PREVIEW DOKUMEN</span><strong>A4</strong>
          </div><span>Klik teks pada kertas untuk mengedit langsung</span><div
            class="preview-page-badge"
          >
            Halaman 1
          </div>
        </div><article id="letter-preview" class="letter-paper">
          <header class="paper-letterhead">
            <div class="paper-mark" id="p-logo">
              <img src="/images/logo-suratku.png" alt="Logo SuratKu" />
            </div><div>
              <strong id="p-company">Nama Perusahaan Anda</strong><small id="p-company-details"
                >Alamat perusahaan · Telepon</small
              >
            </div>
          </header><div class="paper-rule"></div><div class="paper-date" id="p-date">
            Jakarta, 3 September 2026
          </div><dl class="paper-meta">
            <div>
              <dt>Nomor</dt><dd>
                : <span id="p-number" contenteditable="true" data-field="letter_number">—</span>
              </dd>
            </div><div>
              <dt>Lampiran</dt><dd>
                : <span id="p-attachment" contenteditable="true" data-field="attachment">—</span>
              </dd>
            </div><div>
              <dt>Perihal</dt><dd>
                : <span id="p-subject" contenteditable="true" data-field="subject">—</span>
              </dd>
            </div>
          </dl><div class="paper-recipient">
            Yth. <strong id="p-recipient" contenteditable="true" data-field="recipient_name"
              >Bapak/Ibu Penerima</strong
            ><br /><span id="p-recipient-company"></span><br /><span
              id="p-address"
              contenteditable="true"
              data-field="recipient_address">di Tempat</span
            >
          </div><div id="p-body" class="paper-body" contenteditable="true" data-field="body">
            Dengan hormat,<br /><br />Isi surat Anda akan tampil di bagian ini.
          </div><p id="p-closing" class="paper-closing" contenteditable="true" data-field="closing">
          </p><div class="paper-signature">
            <span>Hormat kami,</span><div class="signature-space"></div><strong
              id="p-sender"
              contenteditable="true"
              data-field="sender_name">Nama Pengirim</strong
            ><small id="p-sender-title" contenteditable="true" data-field="sender_title"
              >Jabatan</small
            >
          </div>
        </article>
      </aside>
    </form>
  </section>

  <div id="save-template-modal" class="save-template-modal" hidden>
    <div class="save-template-backdrop" data-close-save-template></div>
    <section
      class="save-template-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="save-template-title"
    >
      <header class="save-template-dialog-head">
        <span class="save-template-dialog-icon">▤</span><div>
          <span>SIMPAN FORMAT</span><h2 id="save-template-title">Jadikan template surat</h2><p>
            Gunakan kembali format ini tanpa mengisi ulang dari awal.
          </p>
        </div><button type="button" class="modal-close" data-close-save-template aria-label="Tutup"
          >×</button
        >
      </header>
      <form id="save-template-form" class="save-template-dialog-body">
        <label for="new-template-name">Nama template</label><div class="template-name-field">
          <span>✦</span><input
            id="new-template-name"
            type="text"
            maxlength="80"
            required
            autocomplete="off"
            placeholder="Contoh: Penawaran kerja sama"
          />
        </div><small>Pilih nama yang singkat dan mudah ditemukan.</small>
        <div class="save-template-summary">
          <div><span>Jenis</span><strong id="save-template-subject">Surat resmi</strong></div><div>
            <span>Tipografi</span><strong id="save-template-font">Lora</strong>
          </div><div>
            <span>Konten</span><strong id="save-template-content">Siap disimpan</strong>
          </div>
        </div>
        <p id="save-template-message" class="message"></p>
        <footer class="save-template-dialog-actions">
          <button class="secondary-button" type="button" data-close-save-template>Batal</button
          ><button id="confirm-save-template" class="primary-button" type="submit"
            >Simpan template</button
          >
        </footer>
      </form>
    </section>
  </div>
</DashboardLayout>

<script>
  import { supabase } from '../../../lib/supabase'
  const form = document.querySelector('#letter-form') as HTMLFormElement
  const status = document.querySelector('#save-status') as HTMLElement
  const message = document.querySelector('#form-message') as HTMLElement
  const paper = document.querySelector('#letter-preview') as HTMLElement
  const fontSelect = document.querySelector('#font_family') as HTMLSelectElement
  const templateSelect = document.querySelector('#template_select') as HTMLInputElement
  const templateButton = document.querySelector('#template-picker-button') as HTMLButtonElement
  const templateMenu = document.querySelector('#template-picker-menu') as HTMLElement
  const templateList = document.querySelector('#composer-template-list') as HTMLElement
  const templateSearch = document.querySelector('#template-picker-search') as HTMLInputElement
  const routeParams = new URLSearchParams(location.search)
  let editingId = routeParams.get('id')
  const initialTemplateId = routeParams.get('template')
  let logoUrl = ''
  let footerAlignment: 'left' | 'right' = 'right'
  let templates: any[] = []
  const fonts = [
    ['Lora', 'Serif'],
    ['Merriweather', 'Serif'],
    ['Libre Baskerville', 'Serif'],
    ['EB Garamond', 'Serif'],
    ['Crimson Pro', 'Serif'],
    ['Source Serif 4', 'Serif'],
    ['Roboto Slab', 'Serif'],
    ['Bitter', 'Serif'],
    ['Alegreya', 'Serif'],
    ['Georgia', 'Serif'],
    ['Times New Roman', 'Serif'],
    ['Inter', 'Sans Serif'],
    ['Roboto', 'Sans Serif'],
    ['Open Sans', 'Sans Serif'],
    ['Source Sans 3', 'Sans Serif'],
    ['DM Sans', 'Sans Serif'],
    ['Manrope', 'Sans Serif'],
    ['Montserrat', 'Sans Serif'],
    ['Poppins', 'Sans Serif'],
    ['Raleway', 'Sans Serif'],
    ['Nunito Sans', 'Sans Serif'],
    ['IBM Plex Sans', 'Sans Serif'],
    ['Fira Sans', 'Sans Serif'],
    ['Ubuntu', 'Sans Serif'],
    ['Arial', 'Sans Serif'],
    ['Playfair Display', 'Display'],
    ['DM Serif Display', 'Display'],
    ['Oswald', 'Display'],
    ['Space Grotesk', 'Display'],
    ['IBM Plex Mono', 'Monospace'],
    ['Courier New', 'Monospace'],
  ]
  const fontButton = document.querySelector('#font-picker-button') as HTMLButtonElement
  const fontMenu = document.querySelector('#font-picker-menu') as HTMLElement
  const fontOptions = document.querySelector('#font-options') as HTMLElement
  const fontSearch = document.querySelector('#font-search') as HTMLInputElement
  fontSelect.innerHTML = fonts.map(([name]) => `<option value="${name}">${name}</option>`).join('')
  function renderFonts(query = '') {
    const q = query.toLowerCase()
    let last = ''
    fontOptions.innerHTML =
      fonts
        .filter(([name]) => name.toLowerCase().includes(q))
        .map(([name, category]) => {
          const heading =
            category !== last ? `<div class="font-category">${(last = category)}</div>` : ''
          return `${heading}<button type="button" class="font-option ${fontSelect.value === name ? 'active' : ''}" data-font="${name}" data-category="${category}" style="font-family:'${name}',sans-serif"><span>${name}</span><small>SuratKu · Aa Bb Cc 123</small></button>`
        })
        .join('') || '<p class="font-empty">Font tidak ditemukan.</p>'
  }
  function chooseFont(name: string, category: string) {
    fontSelect.value = name
    ;(document.querySelector('#selected-font') as HTMLElement).textContent = name
    fontButton.querySelector('small')!.textContent = category
    fontButton.querySelector('span')!.setAttribute('style', `font-family:'${name}',sans-serif`)
    bodyEditor.style.fontFamily = `'${name}', sans-serif`
    closingEditor.style.fontFamily = `'${name}', sans-serif`
    fontMenu.hidden = true
    fontButton.setAttribute('aria-expanded', 'false')
    renderFonts()
    updatePreview()
  }
  fontButton.addEventListener('click', () => {
    fontMenu.hidden = !fontMenu.hidden
    fontButton.setAttribute('aria-expanded', String(!fontMenu.hidden))
    if (!fontMenu.hidden) {
      renderFonts()
      setTimeout(() => fontSearch.focus(), 0)
    }
  })
  fontSearch.addEventListener('input', () => renderFonts(fontSearch.value))
  fontOptions.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-font]') as HTMLElement | null
    if (b) chooseFont(b.dataset.font!, b.dataset.category!)
  })
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.font-control')) {
      fontMenu.hidden = true
      fontButton.setAttribute('aria-expanded', 'false')
    }
  })
  const input = (id: string) =>
    document.querySelector(`#${id}`) as HTMLInputElement | HTMLTextAreaElement
  const escapeHtml = (value = '') =>
    value.replace(
      /[&<>'"]/g,
      (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]!,
    )
  const templateText = (template: any) => {
    if (!template.content_html) return template.body || ''
    const element = document.createElement('div')
    element.innerHTML = template.content_html
    return element.innerText.trim()
  }
  let templateBodyHtml = ''
  let templateBodyText = ''
  const bodyEditor = document.querySelector('#body-editor') as HTMLElement
  const closingEditor = document.querySelector('#closing-editor') as HTMLElement
  const plainTextToHtml = (value = '') =>
    value
      .split(/\n{2,}/)
      .map((paragraph) => `<p>${escapeHtml(paragraph).replace(/\n/g, '<br>')}</p>`)
      .join('')
  const safeTemplateHtml = (html: string) => {
    const parsed = new DOMParser().parseFromString(html, 'text/html')
    parsed.body
      .querySelectorAll('script,style,iframe,object,embed,form,input,button,link,meta')
      .forEach((element) => element.remove())
    parsed.body.querySelectorAll<HTMLElement>('*').forEach((element) => {
      ;[...element.attributes].forEach((attribute) => {
        const safeStyles = attribute.value
          .split(';')
          .map((rule) => rule.trim())
          .filter(Boolean)
        const keepStyle =
          attribute.name === 'style' &&
          safeStyles.every((rule) =>
            /^(text-align\s*:\s*(left|right|center|justify)|color\s*:\s*(#[0-9a-f]{3,8}|rgb\([\d ,.]+\))|background-color\s*:\s*(#[0-9a-f]{3,8}|rgb\([\d ,.]+\)))$/i.test(
              rule,
            ),
          )
        const keepSafeLink =
          element.tagName === 'A' &&
          attribute.name === 'href' &&
          /^(https?:|mailto:)/i.test(attribute.value)
        const keepFooterClass = attribute.name === 'class' && attribute.value === 'template-footer'
        const keepFooterAlignment =
          attribute.name === 'data-align' && ['left', 'right'].includes(attribute.value)
        if (!keepStyle && !keepSafeLink && !keepFooterClass && !keepFooterAlignment)
          element.removeAttribute(attribute.name)
      })
    })
    const seenTitles = new Set<string>()
    let duplicateStart: Element | null = null
    for (const paragraph of [...parsed.body.querySelectorAll('p')]) {
      const title = (paragraph.textContent || '').replace(/\s+/g, ' ').trim()
      const isDocumentTitle =
        title.length >= 15 &&
        title.length <= 100 &&
        title.startsWith('SURAT ') &&
        title === title.toUpperCase()
      if (!isDocumentTitle) continue
      if (seenTitles.has(title)) {
        duplicateStart = paragraph
        break
      }
      seenTitles.add(title)
