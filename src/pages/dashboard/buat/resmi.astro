  function applyPreset() {
    const key = routeParams.get('preset')
    const preset = key ? presetCopy[key] : null
    if (!preset || editingId) return
    input('subject').value = preset.subject
    input('body').value = preset.body
    input('closing').value = preset.closing
    document.querySelector('.composer-header h1')!.textContent = preset.title
  }
  async function init() {
    input('letter_date').value = new Date().toISOString().slice(0, 10)
    applyPreset()
    const {
      data: { user },
    } = await supabase.auth.getUser()
    if (!user) return
    input('sender_name').value = user.user_metadata?.full_name || ''
    const { data: profile } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', user.id)
      .maybeSingle()
    if (profile) {
      input('sender_name').value = profile.full_name || input('sender_name').value
      set('p-company', profile.company_name || profile.full_name || 'Nama Perusahaan Anda')
      set(
        'p-company-details',
        [profile.company_address, profile.company_phone].filter(Boolean).join(' · ') ||
          'Lengkapi identitas di Pengaturan',
      )
      logoUrl = profile.logo_url || ''
    }
    if (editingId) {
      const { data: letter } = await supabase
        .from('letters')
        .select('*')
        .eq('id', editingId)
        .single()
      if (letter) {
        Object.entries(letter).forEach(([key, value]) => {
          const el = document.querySelector(`[name="${key}"]`) as
            HTMLInputElement | HTMLTextAreaElement | null
          if (el && value != null) el.value = String(value)
        })
        fontSelect.value = letter.font_family || 'Lora'
        logoUrl = letter.logo_url || logoUrl
        document.querySelector('.composer-header h1')!.textContent = 'Edit surat'
      }
    }
    const current = fonts.find(([name]) => name === fontSelect.value) || fonts[0]
    chooseFont(current[0], current[1])
    const logo = document.querySelector('#p-logo')!
    if (logoUrl) logo.innerHTML = `<img src="${logoUrl}" alt="Logo perusahaan" />`
    await loadTemplates()
    updatePreview()
  }
  init()
</script>
