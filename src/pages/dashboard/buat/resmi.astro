      template?.name || 'Surat kosong'
    ;(document.querySelector('#selected-template-meta') as HTMLElement).textContent = template
      ? `${template.source_filename ? 'Impor DOCX' : 'Template kustom'} · ${template.variables?.length || 0} field`
      : 'Mulai dari format surat resmi'
    templateButton.classList.toggle('has-template', Boolean(template))
    paper.classList.toggle(
      'has-full-template',
      Boolean(template?.content_html && template?.source_filename),
    )
