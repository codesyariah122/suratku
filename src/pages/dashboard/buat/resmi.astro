            'active',
            (button as HTMLElement).dataset.composerFooterAlign === footerAlignment,
          ),
        )
      updatePreview()
      requestAnimationFrame(updatePreview)
      return
    }
    const t = template
    input('subject').value = t.subject || ''
    templateBodyText = templateText(t)
    templateBodyHtml = t.content_html ? safeTemplateHtml(t.content_html) : ''
    const importedFooter = new DOMParser()
      .parseFromString(templateBodyHtml, 'text/html')
      .querySelector<HTMLElement>('.template-footer')
