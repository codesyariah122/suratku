---
import DashboardLayout from '../../layouts/DashboardLayout.astro'
import PageHeader from '../../components/dashboard/PageHeader.astro'
---

<DashboardLayout title="Dashboard - SuratKu">
  <main class="dashboard-page">
    <div class="dashboard-container">
      <!-- HEADER -->
      <PageHeader
        class="dashboard-header"
        eyebrow="SuratKu"
        title="Dashboard"
        description="Selamat datang di SuratKu."
      />

      <section class="welcome-card">
        <div>
          <span class="dashboard-label">RUANG KERJA ANDA</span><h2>
            Selamat datang, <span id="user-name">Pengguna</span>.
          </h2><p>Buat dokumen formal dengan cepat, konsisten, dan siap dikirim.</p>
        </div>
        <a href="/dashboard/buat/resmi" class="primary-button">+ Buat surat baru</a>
      </section>

      <section class="stats-grid">
        <article class="stat-card">
          <span>Total surat</span><strong id="stat-total">—</strong><small>Dokumen tersimpan</small>
        </article>
        <article class="stat-card">
          <span>Surat final</span><strong id="stat-final">—</strong><small>Siap digunakan</small>
        </article>
        <article class="stat-card">
          <span>Masih draf</span><strong id="stat-draft">—</strong><small>Perlu diselesaikan</small>
        </article>
      </section>

      <!-- MENU -->
      <div class="dashboard-menu">
        <a href="/dashboard/buat" class="dashboard-menu-card">
          <span class="dashboard-menu-number">✎</span>

          <h3>Buat Surat</h3>

          <p>Buat surat baru menggunakan template SuratKu.</p>
        </a>

        <a href="/dashboard/riwayat" class="dashboard-menu-card">
          <span class="dashboard-menu-number">▤</span>

          <h3>Riwayat Surat</h3>

          <p>Lihat dan kelola surat yang sudah dibuat.</p>
        </a>

        <a href="/dashboard/pengaturan" class="dashboard-menu-card">
          <span class="dashboard-menu-number">⌘</span>

          <h3>Pengaturan</h3>

          <p>Kelola informasi akun dan profil kamu.</p>
        </a>
      </div>
    </div>
  </main>
</DashboardLayout>

<script>
  import { supabase } from '../../lib/supabase'

  const userName = document.querySelector('#user-name')
  const statTotal = document.querySelector('#stat-total')
  const statFinal = document.querySelector('#stat-final')
  const statDraft = document.querySelector('#stat-draft')

  async function loadUser() {
    const {
      data: { user },
      error,
    } = await supabase.auth.getUser()

    if (error || !user) {
      window.location.href = '/login'
      return
    }

    const { data: profile } = await supabase
      .from('profiles')
      .select('full_name')
      .eq('id', user.id)
      .maybeSingle()

    const fullName =
      profile?.full_name?.trim() || user.user_metadata?.full_name || 'Pengguna SuratKu'

    if (userName) {
      userName.textContent = fullName
    }

    const { data: letters } = await supabase.from('letters').select('status')
    if (letters) {
      if (statTotal) statTotal.textContent = String(letters.length)
      if (statFinal)
        statFinal.textContent = String(letters.filter((x) => x.status === 'final').length)
      if (statDraft)
        statDraft.textContent = String(letters.filter((x) => x.status === 'draft').length)
    }
  }

  loadUser()
</script>
