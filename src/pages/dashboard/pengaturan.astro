---
import DashboardLayout from '../../layouts/DashboardLayout.astro'
import PageHeader from '../../components/dashboard/PageHeader.astro'
import RichTextToolbar from '../../components/editor/RichTextToolbar.astro'
---

<DashboardLayout title="Identitas Perusahaan - SuratKu">
  <section class="page-shell narrow-shell">
    <PageHeader
      eyebrow="PENGATURAN"
      title="Identitas pengirim"
      description="Data ini akan otomatis dipakai pada surat baru Anda."
    />
    <form id="profile-form" class="panel-card">
      <div class="form-card-header">
        <h2>Profil & kop surat</h2><p>
          Identitas ini menjadi kop dan penandatangan default pada setiap surat baru.
        </p>
      </div>
      <div
        id="logo-dropzone"
        class="logo-dropzone"
        tabindex="0"
        role="button"
        aria-label="Unggah logo perusahaan"
      >
        <input
          id="company_logo"
          type="file"
          accept="image/png,image/jpeg,image/webp,image/svg+xml"
          hidden
        />
        <div id="logo-preview" class="logo-preview"><span>+</span><b>LOGO</b></div>
        <div class="logo-dropzone-copy">
          <span class="logo-upload-label">LOGO PERUSAHAAN</span><h3>
            Tarik dan lepaskan logo di sini
          </h3><p>atau klik untuk memilih dari komputer</p><div class="logo-upload-meta">
            <span>PNG</span><span>JPG</span><span>WEBP</span><span>SVG</span><small
              >Maks. 2 MB</small
            >
          </div><div id="logo-file-info" class="logo-file-info" hidden>
            <strong id="logo-file-name"></strong><span id="logo-file-size"></span>
          </div>
        </div>
        <div class="logo-upload-actions">
          <button id="choose-logo" class="secondary-button" type="button">Pilih logo</button><button
            id="remove-logo"
            class="logo-remove-button"
            type="button"
            hidden>Hapus</button
          >
        </div>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label for="full_name">Nama lengkap</label><input
            id="full_name"
            name="full_name"
            required
          />
        </div>
        <div class="form-group">
          <label for="company_name">Nama perusahaan</label><input
            id="company_name"
            name="company_name"
            placeholder="PT Nama Perusahaan"
          />
        </div>
        <div class="form-group form-group-full profile-address-field">
          <label for="company-address-editor">Alamat dan informasi kop surat</label><textarea
            id="company_address"
            name="company_address"
            class="rich-editor-value"
            aria-hidden="true"></textarea><div class="document-editor profile-rich-editor">
            <RichTextToolbar
              namespace="profile"
              ariaLabel="Format alamat kop surat"
              orderedList={false}
              colors={false}
              fullAlign={false}
              strike={false}
            /><div
              id="company-address-editor"
              class="document-editor-canvas"
              contenteditable="true"
              role="textbox"
              aria-multiline="true"
              data-placeholder="Head Office: Jalan lengkap perusahaan
Cabang: Alamat cabang (opsional)"
            >
            </div>
          </div><small class="field-help">Format teks akan digunakan langsung pada kop surat.</small
          >
        </div>
        <div class="form-group">
          <label for="company_phone">Telepon perusahaan</label><input
            id="company_phone"
            name="company_phone"
            type="tel"
            placeholder="(022) 1234 5678"
          />
        </div>
        <div class="form-group">
          <label for="company_email">Email perusahaan</label><input
            id="company_email"
            name="company_email"
            type="email"
            placeholder="office@perusahaan.com"
          />
        </div>
        <div class="form-group">
          <label for="company_city">Kota untuk tanggal surat</label><input
            id="company_city"
            name="company_city"
            placeholder="Bandung"
          />
        </div>
        <div class="form-group">
          <label for="email">Email akun</label><input id="email" disabled />
        </div>
      </div>
      <div class="profile-section-divider">
        <span>Penandatangan default</span><small>Dapat diganti kembali saat membuat surat.</small>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label for="signer_name">Nama penandatangan</label><input
            id="signer_name"
            name="signer_name"
            placeholder="Nama lengkap"
          />
        </div>
        <div class="form-group">
          <label for="signer_title">Jabatan penandatangan</label><input
            id="signer_title"
            name="signer_title"
            placeholder="Direktur / Manajer"
          />
        </div>
      </div>
      <div class="form-footer">
        <p id="profile-message" class="message"></p><button class="primary-button" type="submit"
          >Simpan perubahan</button
        >
      </div>
    </form>
  </section>
</DashboardLayout>

<script>
  import { supabase } from '../../lib/supabase'
  const form = document.querySelector('#profile-form') as HTMLFormElement
  const message = document.querySelector('#profile-message') as HTMLParagraphElement
  let logoUrl = ''
  let pendingLogoFile: File | null = null
  let previewObjectUrl = ''
  const logoInput = document.querySelector('#company_logo') as HTMLInputElement
  const logoPreview = document.querySelector('#logo-preview') as HTMLDivElement
  const logoDropzone = document.querySelector('#logo-dropzone') as HTMLDivElement
  const fileInfo = document.querySelector('#logo-file-info') as HTMLDivElement
  const fileName = document.querySelector('#logo-file-name') as HTMLElement
  const fileSize = document.querySelector('#logo-file-size') as HTMLElement
  const removeLogo = document.querySelector('#remove-logo') as HTMLButtonElement
  const addressEditor = document.querySelector('#company-address-editor') as HTMLElement
  const addressValue = document.querySelector('#company_address') as HTMLTextAreaElement
  const escapeText = (value = '') =>
    value.replace(/[&<>]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[char]!)
  const sanitizeAddressHtml = (html = '') => {
    const parsed = new DOMParser().parseFromString(html, 'text/html')
    parsed.body
      .querySelectorAll('script,style,iframe,object,embed,img,a,form,input,button')
      .forEach((node) => node.remove())
    parsed.body.querySelectorAll<HTMLElement>('*').forEach((node) => {
      ;[...node.attributes].forEach((attribute) => {
        const keepAlignment =
          attribute.name === 'style' &&
          /^text-align:\s*(left|right|center|justify);?$/i.test(attribute.value.trim())
        if (!keepAlignment) node.removeAttribute(attribute.name)
      })
    })
    return parsed.body.innerHTML
  }
  const syncAddress = () => {
    addressValue.value = sanitizeAddressHtml(addressEditor.innerHTML).trim()
  }
  function showLogo(url: string) {
    logoPreview.innerHTML = url
      ? `<img src="${url}" alt="Logo perusahaan" />`
      : '<img src="/images/logo-suratku.png" alt="Logo bawaan SuratKu" />'
    logoDropzone.classList.toggle('has-logo', Boolean(url))
    removeLogo.hidden = !url
  }
  function selectLogo(file: File) {
    const allowed = ['image/png', 'image/jpeg', 'image/webp', 'image/svg+xml']
    if (!allowed.includes(file.type)) {
      message.textContent = 'Format logo harus PNG, JPG, WebP, atau SVG.'
      message.className = 'message error'
      return
    }
    if (file.size > 2097152) {
      message.textContent = 'Ukuran logo maksimal 2 MB.'
      message.className = 'message error'
      return
    }
    pendingLogoFile = file
    if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl)
    previewObjectUrl = URL.createObjectURL(file)
    showLogo(previewObjectUrl)
    fileName.textContent = file.name
    fileSize.textContent = `${file.size >= 1024 * 1024 ? `${(file.size / 1024 / 1024).toFixed(2)} MB` : `${(file.size / 1024).toFixed(1)} KB`} · siap diunggah`
    fileInfo.hidden = false
    message.textContent = ''
    logoDropzone.classList.add('file-ready')
  }
  async function load() {
    const {
      data: { user },
    } = await supabase.auth.getUser()
    if (!user) return
    ;(document.querySelector('#email') as HTMLInputElement).value = user.email || ''
    const { data } = await supabase.from('profiles').select('*').eq('id', user.id).maybeSingle()
    ;(document.querySelector('#full_name') as HTMLInputElement).value =
      data?.full_name || user.user_metadata?.full_name || ''
    ;(document.querySelector('#company_name') as HTMLInputElement).value = data?.company_name || ''
    const savedAddress = String(data?.company_address || '')
    addressEditor.innerHTML = /<[^>]+>/.test(savedAddress)
      ? sanitizeAddressHtml(savedAddress)
      : savedAddress
          .split(/\n+/)
          .filter(Boolean)
          .map((line) => `<p>${escapeText(line)}</p>`)
          .join('')
    syncAddress()
    ;(document.querySelector('#company_phone') as HTMLInputElement).value =
      data?.company_phone || ''
    ;(document.querySelector('#company_email') as HTMLInputElement).value =
      data?.company_email || ''
    ;(document.querySelector('#company_city') as HTMLInputElement).value = data?.company_city || ''
    ;(document.querySelector('#signer_name') as HTMLInputElement).value =
      data?.signer_name || data?.full_name || ''
    ;(document.querySelector('#signer_title') as HTMLInputElement).value = data?.signer_title || ''
    logoUrl = data?.logo_url || ''
    showLogo(logoUrl)
  }
  logoInput?.addEventListener('change', () => {
    const file = logoInput.files?.[0]
    if (file) selectLogo(file)
  })
  document.querySelector('#choose-logo')?.addEventListener('click', (event) => {
    event.stopPropagation()
    logoInput.click()
  })
  logoDropzone.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('button')) logoInput.click()
  })
  logoDropzone.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault()
      logoInput.click()
    }
  })
  ;['dragenter', 'dragover'].forEach((type) =>
    logoDropzone.addEventListener(type, (event) => {
      event.preventDefault()
      logoDropzone.classList.add('is-dragging')
    }),
  )
  ;['dragleave', 'drop'].forEach((type) =>
    logoDropzone.addEventListener(type, (event) => {
      event.preventDefault()
      logoDropzone.classList.remove('is-dragging')
    }),
  )
  logoDropzone.addEventListener('drop', (event) => {
    const file = event.dataTransfer?.files?.[0]
    if (file) selectLogo(file)
  })
  removeLogo.addEventListener('click', (event) => {
    event.stopPropagation()
    pendingLogoFile = null
    logoInput.value = ''
    logoUrl = ''
    fileInfo.hidden = true
    logoDropzone.classList.remove('file-ready')
    showLogo('')
  })
  document.querySelectorAll<HTMLButtonElement>('[data-profile-command]').forEach((button) => {
    button.addEventListener('mousedown', (event) => event.preventDefault())
    button.addEventListener('click', () => {
      addressEditor.focus()
      document.execCommand(button.dataset.profileCommand || '', false)
      syncAddress()
    })
  })
  addressEditor.addEventListener('input', syncAddress)
  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    syncAddress()
    const {
      data: { user },
    } = await supabase.auth.getUser()
    if (!user) return
    const file = pendingLogoFile || logoInput.files?.[0]
    if (file) {
      if (file.size > 2097152) {
        message.textContent = 'Ukuran logo maksimal 2 MB.'
        message.className = 'message error'
        return
      }
      const ext = file.name.split('.').pop()
      const path = `${user.id}/logo.${ext}`
      const { error: uploadError } = await supabase.storage
        .from('company-assets')
        .upload(path, file, { upsert: true })
      if (uploadError) {
        message.textContent = 'Logo gagal diunggah. Jalankan migration document builder.'
        message.className = 'message error'
        return
      }
      logoUrl =
        supabase.storage.from('company-assets').getPublicUrl(path).data.publicUrl +
        `?v=${Date.now()}`
    }
    const fd = new FormData(form)
    const payload = {
      id: user.id,
      full_name: fd.get('full_name'),
      company_name: fd.get('company_name'),
      company_address: fd.get('company_address'),
      company_phone: fd.get('company_phone'),
      company_email: fd.get('company_email'),
      company_city: fd.get('company_city'),
      signer_name: fd.get('signer_name'),
      signer_title: fd.get('signer_title'),
      logo_url: logoUrl || null,
    }
    const { data: updatedProfile, error: updateError } = await supabase
      .from('profiles')
      .update(payload)
      .eq('id', user.id)
      .select('id')
      .maybeSingle()
    let saveError = updateError
    if (!updateError && !updatedProfile) {
      const { error: insertError } = await supabase.from('profiles').insert(payload)
      saveError = insertError
    }
    if (saveError) {
      const missingColumn = /Could not find the '([^']+)' column/.exec(saveError.message)?.[1]
      message.textContent = missingColumn
        ? `Database belum diperbarui: kolom ${missingColumn} belum tersedia. Jalankan migration repair document profile schema di Supabase.`
        : `Gagal menyimpan profil: ${saveError.message}`
      message.className = 'message error'
      return
    }
    pendingLogoFile = null
    logoInput.value = ''
    logoDropzone.classList.remove('file-ready')
    showLogo(logoUrl)
    if (fileInfo.hidden === false) fileSize.textContent = 'Berhasil diunggah dan disimpan'
    message.textContent = 'Perubahan profil dan logo berhasil disimpan.'
    message.className = 'message success'
  })
  load()
</script>
