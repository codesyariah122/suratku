---
import DashboardLayout from '../../layouts/DashboardLayout.astro'
import PageHeader from '../../components/dashboard/PageHeader.astro'
import { letterCatalog as groups } from '../../data/letterCatalog'
---

<DashboardLayout title="Katalog Surat - SuratKu">
  <section class="page-shell catalog-shell">
    <PageHeader
      eyebrow="KATALOG TEMPLATE"
      title="Buat surat perusahaan"
      description="Pilih format siap pakai atau mulai dari template milik Anda."
    >
      <a href="/dashboard/templates" class="secondary-button">Kelola template saya</a>
    </PageHeader>
    <div class="catalog-toolbar">
      <label class="search-box"
        ><span>⌕</span><input
          id="catalog-search"
          type="search"
          placeholder="Cari jenis surat…"
        /></label
      ><span id="catalog-total">24 format profesional</span>
    </div>
    <div id="catalog-groups">
      <section id="personal-template-group" class="catalog-group personal-catalog-group" hidden>
        <div class="catalog-group-head">
          <div>
            <span class="catalog-personal-label">KOLEKSI ANDA</span>
            <h2>Template saya</h2>
            <p>Template kustom dan hasil impor dokumen Word.</p>
          </div>
          <span id="personal-template-count"></span>
        </div>
        <div id="personal-template-grid" class="catalog-grid"></div>
      </section>
      {
        groups.map((group) => (
          <section class="catalog-group">
            <>
              <div class="catalog-group-head">
                <>
                  <div>
                    <>
                      <h2>{group.name}</h2>
                      <p>{group.description}</p>
                    </>
                  </div>
                  <span>{group.items.length} template</span>
                </>
              </div>
              <div class="catalog-grid">
                {group.items.map(([slug, title, desc, icon]) => (
                  <a
                    class="catalog-card"
                    href={`/dashboard/buat/resmi?preset=${slug}`}
                    data-search={`${title} ${desc}`.toLowerCase()}
                  >
                    <span class="catalog-icon">{icon}</span>
                    <div>
                      <h3>{title}</h3>
                      <p>{desc}</p>
                    </div>
                    <span class="catalog-arrow">→</span>
                  </a>
                ))}
              </div>
            </>
          </section>
        ))
      }
    </div>
  </section>
</DashboardLayout>

<script>
  import { supabase } from '../../lib/supabase'

  const search = document.querySelector('#catalog-search') as HTMLInputElement
  const esc = (value: string) =>
    value.replace(
      /[&<>'"]/g,
      (character) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character] ||
        character,
    )
  function filterCatalog() {
    const q = search.value.toLowerCase().trim()
    document.querySelectorAll('.catalog-card').forEach((card) => {
      ;(card as HTMLElement).hidden = !((card as HTMLElement).dataset.search || '').includes(q)
    })
    document.querySelectorAll('.catalog-group').forEach((group) => {
      ;(group as HTMLElement).hidden =
        group.querySelectorAll('.catalog-card:not([hidden])').length === 0
    })
  }
  search?.addEventListener('input', filterCatalog)

  async function loadPersonalTemplates() {
    const { data } = await supabase
      .from('letter_templates')
      .select('id,name,source_filename,category,variables,updated_at')
      .order('updated_at', { ascending: false })
    if (!data?.length) return
    const group = document.querySelector('#personal-template-group') as HTMLElement
    const grid = document.querySelector('#personal-template-grid') as HTMLElement
    grid.innerHTML = data
      .map((template, index) => {
        const imported = template.category === 'imported' || template.source_filename
        const description = imported
          ? `Diimpor dari ${template.source_filename || 'dokumen Word'}`
          : `${Array.isArray(template.variables) ? template.variables.length : 0} field dinamis`
        return `<a class="catalog-card personal-template-card" href="/dashboard/buat/resmi?template=${encodeURIComponent(template.id)}" data-search="${esc(`${template.name} ${description}`.toLowerCase())}"><span class="catalog-icon">${imported ? 'W' : '✦'}</span><div><span class="template-origin">${imported ? 'DOCX' : 'KUSTOM'}</span><h3>${esc(template.name)}</h3><p>${esc(description)}</p></div><span class="catalog-arrow">→</span></a>`
      })
      .join('')
    group.hidden = false
    ;(document.querySelector('#personal-template-count') as HTMLElement).textContent =
      `${data.length} template`
    ;(document.querySelector('#catalog-total') as HTMLElement).textContent =
      `${24 + data.length} format tersedia`
    filterCatalog()
  }
  loadPersonalTemplates()
</script>
