---
interface Props {
  href?: string
  class?: string
  tagline?: string
  decorative?: boolean
  compact?: boolean
}

const {
  href = '/',
  class: className = 'marketing-brand',
  tagline,
  decorative = false,
  compact = false,
} = Astro.props
---

<a href={href} class:list={[className, { 'brand-compact': compact }]}>
  <img src="/images/logo-suratku.png" alt={decorative ? '' : 'Logo SuratKu'} />
  <span>
    <strong>SuratKu</strong>
    {tagline && <small>{tagline}</small>}
  </span>
</a>

<style>
  .marketing-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: #111a2d;
    text-decoration: none;
  }

  .marketing-brand img {
    width: 45px;
    height: 45px;
    flex: none;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 8px 20px #10203d2b;
  }

  .marketing-brand > span {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .marketing-brand strong {
    font-size: 19px;
    line-height: 1.15;
    letter-spacing: -0.4px;
  }

  .marketing-brand small {
    color: #8a94a5;
    font-size: 7px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.18em;
  }

  .marketing-brand.brand-compact img {
    width: 37px;
    height: 37px;
    border-radius: 10px;
  }

  :global(.sidebar-brand),
  :global(.mobile-brand),
  :global(.auth-home) {
    white-space: nowrap;
  }

  :global(.sidebar-brand > span),
  :global(.mobile-brand > span),
  :global(.auth-home > span) {
    display: contents;
  }

  :global(.sidebar-brand strong),
  :global(.mobile-brand strong),
  :global(.auth-home strong) {
    color: inherit;
    font: inherit;
  }
</style>
