---
import Brand from '../Brand.astro'
---

<header class="mobile-dashboard-header">
  <button type="button" id="sidebar-toggle" class="sidebar-toggle" aria-label="Buka menu">
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line
        x1="4"
        y1="18"
        x2="20"
        y2="18"></line>
    </svg>
  </button>
  <Brand href="/dashboard" class="mobile-brand" decorative />
</header>
