<div id="app-dialog" class="app-dialog" hidden>
  <div class="app-dialog-backdrop" data-dialog-cancel></div>
  <section
    class="app-dialog-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="app-dialog-title"
  >
    <button class="app-dialog-close" type="button" data-dialog-cancel aria-label="Tutup">×</button>
    <div id="app-dialog-icon" class="app-dialog-icon">!</div>
    <span id="app-dialog-eyebrow" class="app-dialog-eyebrow">KONFIRMASI</span>
    <h2 id="app-dialog-title">Konfirmasi tindakan</h2>
    <p id="app-dialog-message"></p>
    <div class="app-dialog-actions">
      <button id="app-dialog-cancel" class="secondary-button" type="button" data-dialog-cancel
        >Batal</button
      >
      <button id="app-dialog-confirm" class="primary-button" type="button">Lanjutkan</button>
    </div>
  </section>
</div>
