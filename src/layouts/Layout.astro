---
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'SuratKu' } = Astro.props
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="SuratKu - Generator Surat Digital" />
    <link rel="icon" type="image/png" href="/images/logo-suratku.png" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
