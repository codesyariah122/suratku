---
import { supabase } from '../lib/supabase'
import AppDialog from '../components/dashboard/AppDialog.astro'
import DashboardSidebar from '../components/dashboard/DashboardSidebar.astro'
import MobileDashboardHeader from '../components/dashboard/MobileDashboardHeader.astro'
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'Dashboard - SuratKu' } = Astro.props
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="SuratKu - Buat surat resmi dengan mudah." />

    <link rel="icon" type="image/png" href="/images/logo-suratku.png" />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Alegreya:wght@400;600;700&family=Bitter:wght@400;600;700&family=Crimson+Pro:wght@400;600;700&family=DM+Sans:wght@400;600;700&family=DM+Serif+Display&family=EB+Garamond:wght@400;600;700&family=Fira+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600;700&family=Inter:wght@400;600;700&family=Libre+Baskerville:wght@400;700&family=Lora:wght@400;600;700&family=Manrope:wght@400;600;700&family=Merriweather:wght@400;700&family=Montserrat:wght@400;600;700&family=Nunito+Sans:wght@400;600;700&family=Open+Sans:wght@400;600;700&family=Oswald:wght@400;600;700&family=Playfair+Display:wght@400;600;700&family=Poppins:wght@400;600;700&family=Raleway:wght@400;600;700&family=Roboto:wght@400;500;700&family=Roboto+Slab:wght@400;600;700&family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:wght@400;600;700&family=Space+Grotesk:wght@400;600;700&family=Ubuntu:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="dashboard-layout">
      <DashboardSidebar />
      <div class="sidebar-overlay" id="sidebar-overlay"></div>
      <div class="dashboard-main">
        <MobileDashboardHeader />
        <main class="dashboard-content">
          <slot />
        </main>
      </div>
    </div>
    <AppDialog />

    <!-- ========================================
         SCRIPT
    ========================================= -->

    <script>
      import { supabase } from '../lib/supabase'

      type DialogOptions = {
        title?: string
        message: string
        confirmText?: string
        cancelText?: string
        tone?: 'danger' | 'info' | 'success'
        eyebrow?: string
        alert?: boolean
      }
      const dialog = document.querySelector('#app-dialog') as HTMLElement
      const dialogCard = dialog.querySelector('.app-dialog-card') as HTMLElement
      const dialogTitle = document.querySelector('#app-dialog-title') as HTMLElement
      const dialogMessage = document.querySelector('#app-dialog-message') as HTMLElement
      const dialogEyebrow = document.querySelector('#app-dialog-eyebrow') as HTMLElement
      const dialogIcon = document.querySelector('#app-dialog-icon') as HTMLElement
      const dialogConfirm = document.querySelector('#app-dialog-confirm') as HTMLButtonElement
      const dialogCancel = document.querySelector('#app-dialog-cancel') as HTMLButtonElement
      let resolveDialog: ((result: boolean) => void) | null = null

      function closeDialog(result: boolean) {
        if (dialog.hidden) return
        dialog.hidden = true
        document.body.classList.remove('modal-open')
        resolveDialog?.(result)
        resolveDialog = null
      }

      function showDialog(options: DialogOptions) {
        if (resolveDialog) closeDialog(false)
        dialogTitle.textContent = options.title || 'Konfirmasi tindakan'
        dialogMessage.textContent = options.message
        dialogEyebrow.textContent = options.eyebrow || (options.alert ? 'INFORMASI' : 'KONFIRMASI')
        dialogConfirm.textContent =
          options.confirmText || (options.alert ? 'Mengerti' : 'Lanjutkan')
        dialogCancel.textContent = options.cancelText || 'Batal'
        dialogCancel.hidden = Boolean(options.alert)
        const tone = options.tone || 'info'
        dialogCard.dataset.tone = tone
        dialogIcon.textContent = tone === 'danger' ? '!' : tone === 'success' ? '✓' : 'i'
        dialog.hidden = false
        document.body.classList.add('modal-open')
        setTimeout(() => dialogConfirm.focus(), 0)
        return new Promise<boolean>((resolve) => {
          resolveDialog = resolve
        })
      }

      ;(
        window as Window & {
          suratkuDialog?: {
            confirm: (options: DialogOptions) => Promise<boolean>
            alert: (options: DialogOptions) => Promise<boolean>
          }
        }
      ).suratkuDialog = {
        confirm: showDialog,
        alert: (options) => showDialog({ ...options, alert: true }),
      }
      dialogConfirm.addEventListener('click', () => closeDialog(true))
      dialog
        .querySelectorAll('[data-dialog-cancel]')
        .forEach((element) => element.addEventListener('click', () => closeDialog(false)))
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !dialog.hidden) closeDialog(false)
      })

      // ========================================
      // CHECK AUTH
      // ========================================

      async function checkUser() {
        const {
          data: { user },
        } = await supabase.auth.getUser()

        if (!user) {
          window.location.href = '/login'
          return
        }
      }

      checkUser()

      // ========================================
      // LOGOUT
      // ========================================

      const logoutButton = document.getElementById('logout-button')

      logoutButton?.addEventListener('click', async () => {
        logoutButton.setAttribute('disabled', 'true')

        const { error } = await supabase.auth.signOut()

        if (error) {
          console.error('Logout error:', error)

          logoutButton.removeAttribute('disabled')

          return
        }

        window.location.href = '/login'
      })

      // ========================================
      // ACTIVE MENU
      // ========================================

      const currentPath = window.location.pathname

      const navLinks = document.querySelectorAll('[data-nav-link]')

      navLinks.forEach((link) => {
        const href = link.getAttribute('data-nav-link')

        if (!href) {
          return
        }

        if (href === '/dashboard' && currentPath === '/dashboard') {
          link.classList.add('active')
          return
        }

        if (href !== '/dashboard' && currentPath.startsWith(href)) {
          link.classList.add('active')
        }
      })

      // ========================================
      // MOBILE SIDEBAR
      // ========================================

      const sidebar = document.getElementById('dashboard-sidebar')

      const overlay = document.getElementById('sidebar-overlay')

      const toggle = document.getElementById('sidebar-toggle')

      function openSidebar() {
        sidebar?.classList.add('open')
        overlay?.classList.add('open')
        document.body.classList.add('sidebar-open')
      }

      function closeSidebar() {
        sidebar?.classList.remove('open')
        overlay?.classList.remove('open')
        document.body.classList.remove('sidebar-open')
      }

      toggle?.addEventListener('click', openSidebar)

      overlay?.addEventListener('click', closeSidebar)

      // Close sidebar after clicking menu
      navLinks.forEach((link) => {
        link.addEventListener('click', closeSidebar)
      })
    </script>
  </body>
</html>
