---
import { supabase } from '../lib/supabase'
import '../styles/global.css'

interface Props {
  title?: string
}

const {
  title = 'Dashboard - SuratKu'
} = Astro.props
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="SuratKu - Buat surat resmi dengan mudah."
    />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <div class="dashboard-layout">

      <!-- ========================================
           SIDEBAR
      ========================================= -->

      <aside class="dashboard-sidebar" id="dashboard-sidebar">

        <!-- BRAND -->
        <div class="sidebar-header">

          <a
            href="/dashboard"
            class="sidebar-brand"
          >
            SuratKu
          </a>

        </div>


        <!-- NAVIGATION -->
        <nav class="sidebar-nav">

          <div class="sidebar-section">

            <span class="sidebar-section-title">
              MENU
            </span>

            <a
              href="/dashboard"
              class="sidebar-link"
              data-nav-link="/dashboard"
            >
              <span class="sidebar-link-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect
                    x="3"
                    y="3"
                    width="7"
                    height="7"
                  />
                  <rect
                    x="14"
                    y="3"
                    width="7"
                    height="7"
                  />
                  <rect
                    x="14"
                    y="14"
                    width="7"
                    height="7"
                  />
                  <rect
                    x="3"
                    y="14"
                    width="7"
                    height="7"
                  />
                </svg>
              </span>

              <span>
                Dashboard
              </span>
            </a>


            <a
              href="/dashboard/buat"
              class="sidebar-link"
              data-nav-link="/dashboard/buat"
            >
              <span class="sidebar-link-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M12 20h9"
                  />
                  <path
                    d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"
                  />
                </svg>
              </span>

              <span>
                Buat Surat
              </span>
            </a>


            <a
              href="/dashboard/riwayat"
              class="sidebar-link"
              data-nav-link="/dashboard/riwayat"
            >
              <span class="sidebar-link-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M3 12a9 9 0 1 0 3-6.7"
                  />
                  <path
                    d="M3 4v6h6"
                  />
                  <path
                    d="M12 7v5l3 2"
                  />
                </svg>
              </span>

              <span>
                Riwayat
              </span>
            </a>


            <a
              href="/dashboard/pengaturan"
              class="sidebar-link"
              data-nav-link="/dashboard/pengaturan"
            >
              <span class="sidebar-link-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="3"
                  />
                  <path
                    d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-1.7 1.7-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V20h-2.4v-.08a1.7 1.7 0 0 0-1.03-1.56 1.7 1.7 0 0 0-1.88.34l-.06.06-1.7-1.7.06-.06A1.7 1.7 0 0 0 8.46 15a1.7 1.7 0 0 0-1.56-1.03H6V11.6h.08A1.7 1.7 0 0 0 7.64 10a1.7 1.7 0 0 0-.34-1.88l-.06-.06 1.7-1.7.06.06A1.7 1.7 0 0 0 10.88 6.1 1.7 1.7 0 0 0 11.9 4.54V4h2.4v.08a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.88-.34l.06-.06 1.7 1.7-.06.06A1.7 1.7 0 0 0 18.58 9a1.7 1.7 0 0 0 1.56 1.03H20v2.4h-.08A1.7 1.7 0 0 0 18.46 15Z"
                  />
                </svg>
              </span>

              <span>
                Pengaturan
              </span>
            </a>

          </div>

        </nav>


        <!-- SIDEBAR FOOTER -->
        <div class="sidebar-footer">

          <button
            type="button"
            id="logout-button"
            class="sidebar-logout"
          >

            <span class="sidebar-link-icon">

              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                />
                <polyline
                  points="16 17 21 12 16 7"
                />
                <line
                  x1="21"
                  y1="12"
                  x2="9"
                  y2="12"
                />
              </svg>

            </span>

            <span>
              Keluar
            </span>

          </button>

        </div>

      </aside>


      <!-- ========================================
           MOBILE OVERLAY
      ========================================= -->

      <div
        class="sidebar-overlay"
        id="sidebar-overlay"
      ></div>


      <!-- ========================================
           MAIN AREA
      ========================================= -->

      <div class="dashboard-main">

        <!-- MOBILE HEADER -->
        <header class="mobile-dashboard-header">

          <button
            type="button"
            id="sidebar-toggle"
            class="sidebar-toggle"
            aria-label="Buka menu"
          >

            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line
                x1="4"
                y1="6"
                x2="20"
                y2="6"
              />
              <line
                x1="4"
                y1="12"
                x2="20"
                y2="12"
              />
              <line
                x1="4"
                y1="18"
                x2="20"
                y2="18"
              />
            </svg>

          </button>

          <a
            href="/dashboard"
            class="mobile-brand"
          >
            SuratKu
          </a>

        </header>


        <!-- PAGE CONTENT -->
        <main class="dashboard-content">
          <slot />
        </main>

      </div>

    </div>


    <!-- ========================================
         SCRIPT
    ========================================= -->

    <script>
      import { supabase } from '../lib/supabase'

      // ========================================
      // CHECK AUTH
      // ========================================

      async function checkUser() {
        const {
          data: { user },
        } = await supabase.auth.getUser()

        if (!user) {
          window.location.href = '/login'
          return
        }
      }

      checkUser()


      // ========================================
      // LOGOUT
      // ========================================

      const logoutButton =
        document.getElementById('logout-button')

      logoutButton?.addEventListener(
        'click',
        async () => {

          logoutButton.setAttribute(
            'disabled',
            'true'
          )

          const {
            error
          } = await supabase.auth.signOut()

          if (error) {
            console.error(
              'Logout error:',
              error
            )

            logoutButton.removeAttribute(
              'disabled'
            )

            return
          }

          window.location.href = '/login'
        }
      )


      // ========================================
      // ACTIVE MENU
      // ========================================

      const currentPath =
        window.location.pathname

      const navLinks =
        document.querySelectorAll(
          '[data-nav-link]'
        )

      navLinks.forEach((link) => {

        const href =
          link.getAttribute(
            'data-nav-link'
          )

        if (!href) {
          return
        }

        if (
          href === '/dashboard' &&
          currentPath === '/dashboard'
        ) {
          link.classList.add('active')
          return
        }

        if (
          href !== '/dashboard' &&
          currentPath.startsWith(href)
        ) {
          link.classList.add('active')
        }

      })


      // ========================================
      // MOBILE SIDEBAR
      // ========================================

      const sidebar =
        document.getElementById(
          'dashboard-sidebar'
        )

      const overlay =
        document.getElementById(
          'sidebar-overlay'
        )

      const toggle =
        document.getElementById(
          'sidebar-toggle'
        )

      function openSidebar() {
        sidebar?.classList.add('open')
        overlay?.classList.add('open')
        document.body.classList.add(
          'sidebar-open'
        )
      }

      function closeSidebar() {
        sidebar?.classList.remove('open')
        overlay?.classList.remove('open')
        document.body.classList.remove(
          'sidebar-open'
        )
      }

      toggle?.addEventListener(
        'click',
        openSidebar
      )

      overlay?.addEventListener(
        'click',
        closeSidebar
      )


      // Close sidebar after clicking menu
      navLinks.forEach((link) => {

        link.addEventListener(
          'click',
          closeSidebar
        )

      })

    </script>

  </body>
</html>